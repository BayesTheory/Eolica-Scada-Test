# Copie para `.env` e ajuste. O `.env` é gitignored — nunca commite.
#
# Todas as variáveis usam o prefixo EOLICA_ e são validadas por
# `eolica.infrastructure.config.Settings` na subida do processo: configuração
# inválida impede o deploy em vez de gerar erro na milésima requisição.

# ── ambiente ─────────────────────────────────────────────────────────────────
EOLICA_ENVIRONMENT=local          # local | ci | staging | production
EOLICA_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
EOLICA_LOG_FORMAT=console         # json em produção, console em dev

# ── dados ────────────────────────────────────────────────────────────────────
# Se o dataset processado não existir, a aplicação sobe com o sample versionado
# e registra um WARNING dizendo isso. Fallback explícito, nunca silencioso.
EOLICA_DATA_PATH=data/processed/scada_resampled_10min_base.csv
EOLICA_SAMPLE_DATA_PATH=data/samples/scada_sample.csv
EOLICA_SAMPLING_INTERVAL_MINUTES=10

# ── registry de modelos ──────────────────────────────────────────────────────
EOLICA_MLFLOW_TRACKING_URI=http://127.0.0.1:5000
EOLICA_HEALTH_MODEL_NAME=wind-turbine-health-specialist
EOLICA_FORECAST_MODEL_NAME=wind-power-forecaster
# Alias promovido conscientemente. `latest` é recusado em produção pela
# validação da config: no v1, `models:/nome/latest` fazia qualquer experimento
# recém-registrado num notebook virar o modelo de produção sem review.
EOLICA_MODEL_STAGE=Production

# ── detector de anomalia ─────────────────────────────────────────────────────
EOLICA_ANOMALY_THRESHOLD_PERCENTILE=99.5
# Janelas consecutivas acima do limiar para caracterizar alerta.
# 6 × 10min = 1 hora de desvio sustentado. Abaixo disso é ruído de sensor.
EOLICA_PERSISTENCE_WINDOW=6
EOLICA_HEALTH_WINDOW_SIZE=60

# ── previsão ─────────────────────────────────────────────────────────────────
EOLICA_FORECAST_N_LAGS=6
EOLICA_FORECAST_HORIZON_STEPS=1

# ── drift ────────────────────────────────────────────────────────────────────
EOLICA_DRIFT_BINS=10
EOLICA_DRIFT_REFERENCE_DAYS=30

# ── API ──────────────────────────────────────────────────────────────────────
EOLICA_API_HOST=0.0.0.0
EOLICA_API_PORT=8000
EOLICA_ENABLE_METRICS=true
# Lista vazia = CORS desabilitado. Preencha só se houver front separado.
# EOLICA_CORS_ALLOWED_ORIGINS=["https://exemplo.com"]

# ── provisionamento GCP (lido por scripts/setup-gcp.sh, NÃO pela aplicação) ──
#
# Sem o prefixo EOLICA_ de propósito: estas variáveis não são configuração de
# runtime. O processo Python nunca as consulta — ele só lê CSV e serve HTTP.
# São valores do operador, usados uma vez para provisionar a infraestrutura e
# popular as variáveis do GitHub Actions.
#
# Ficam aqui, e não na documentação, porque o repositório é público: o
# identificador de projeto não é credencial, mas também não precisa ser
# indexado. O `.env` é gitignored.
#
# Se um dia a aplicação passar a ler de um bucket GCS ou do Secret Manager,
# aí sim `PROJECT_ID` vira dependência de runtime e ganha o prefixo EOLICA_.

GCP_PROJECT_ID=seu-projeto-id
GCP_PROJECT_NUMBER=000000000000
GCP_REGION=southamerica-east1
GITHUB_REPO=SEU-USUARIO/SEU-REPO

# ── co-piloto conversacional (opcional, desligado por padrão) ────────────────
EOLICA_COPILOT_ENABLED=false
# Chave do Google AI Studio. Sem default, nunca no código-fonte.
# Se COPILOT_ENABLED=true e esta variável faltar, a aplicação recusa subir.
# EOLICA_GEMINI_API_KEY=
EOLICA_GEMINI_MODEL=gemini-2.0-flash
