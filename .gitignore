# ─────────────────────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────────────────────────────────────
# Claude Code — instruções do projeto (CLAUDE.md) SÃO versionadas.
# Só o estado local da sessão fica de fora.
# ─────────────────────────────────────────────────────────────────────────────
.claude/settings.local.json
.claude/state/

# ─────────────────────────────────────────────────────────────────────────────
# Infra local
# ─────────────────────────────────────────────────────────────────────────────
docker-compose.override.yml
.docker/
*.log
logs/
prometheus_data/
grafana_data/
