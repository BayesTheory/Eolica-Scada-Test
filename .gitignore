# ─────────────────────────────────────────────────────────────────────────────
# MLOps — artefatos e tracking são OUTPUT, não código-fonte.
# Rodar `mlflow server` localmente gera milhares de arquivos: nunca commitar.
# ─────────────────────────────────────────────────────────────────────────────
mlruns/
mlartifacts/
mlflow_artifacts*/
artifacts/
outputs/
lightning_logs/
wandb/
*.pkl
*.joblib
*.pth
*.pt
*.onnx
*.ckpt
*.h5
*.safetensors
mlflow.db

# ─────────────────────────────────────────────────────────────────────────────
# Dados — o dataset bruto vem do Zenodo, os derivados são gerados pelo pipeline.
# Só o sample pequeno (usado por testes e pelo modo demo) é versionado.
# ─────────────────────────────────────────────────────────────────────────────
data/raw/
data/interim/
data/processed/
data/external/
*.csv
*.parquet
*.feather
!data/samples/*.csv
!data/metadata/*.csv

# ─────────────────────────────────────────────────────────────────────────────
# Notebooks
# ─────────────────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*-checkpoint.ipynb

# ─────────────────────────────────────────────────────────────────────────────
